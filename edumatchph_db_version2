-- ============================================================
-- EduMatch PH — Complete Database Schema (Current / Final)
-- Run this in phpMyAdmin's SQL tab, inside a database named
-- scholarmatch_db (or your preferred name).
-- Matches the ERD: 17 tables across 5 clusters.
-- ============================================================

DROP TABLE IF EXISTS
    saved_scholarships, recommendation_reasons, recommendations,
    student_profile_scores, student_profiles, assessment_answers, assessments,
    scholarship_locations, scholarship_tags, scholarship_year_levels, scholarship_courses,
    scholarships, administrators, students,
    locations, tags, year_levels, courses;

-- ------------------------------------------------------------
-- CLUSTER 1: LOOKUP TABLES
-- Fixed reference values reused everywhere else, so "BS Computer
-- Science" is stored once and referenced by ID — never re-typed
-- as free text, which is what keeps matching reliable.
-- ------------------------------------------------------------

CREATE TABLE courses (
    course_id INT AUTO_INCREMENT PRIMARY KEY,
    course_name VARCHAR(150) NOT NULL UNIQUE,
    course_category VARCHAR(50) -- e.g. 'STEM', 'Business' — enables broad-category matching
);

CREATE TABLE year_levels (
    year_level_id INT AUTO_INCREMENT PRIMARY KEY,
    year_level_name VARCHAR(50) NOT NULL UNIQUE -- e.g. '1st Year', 'Graduate'
);

CREATE TABLE tags (
    tag_id INT AUTO_INCREMENT PRIMARY KEY,
    tag_name VARCHAR(100) NOT NULL UNIQUE -- e.g. 'STEM', 'Leadership', 'Research', 'Technology'
);

CREATE TABLE locations (
    location_id INT AUTO_INCREMENT PRIMARY KEY,
    location_name VARCHAR(100) NOT NULL UNIQUE, -- e.g. 'Lapu-Lapu City', 'Cebu Province', 'Philippines'
    location_level ENUM('city', 'province', 'region', 'nationwide') NOT NULL
);

-- ------------------------------------------------------------
-- CLUSTER 2: ACCOUNTS
-- ------------------------------------------------------------

CREATE TABLE students (
    student_id INT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    course_id INT,
    year_level_id INT,
    gpa DECIMAL(3,2),
    income_range DECIMAL(10,2),
    location_id INT,
    date_registered TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (course_id) REFERENCES courses(course_id) ON DELETE SET NULL,
    FOREIGN KEY (year_level_id) REFERENCES year_levels(year_level_id) ON DELETE SET NULL,
    FOREIGN KEY (location_id) REFERENCES locations(location_id) ON DELETE SET NULL
);

CREATE TABLE administrators (
    admin_id INT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ------------------------------------------------------------
-- CLUSTER 3: SCHOLARSHIPS
-- Main table + 4 join tables for genuine many-to-many
-- relationships (one scholarship can allow multiple courses,
-- year levels, tags, and locations at once).
-- ------------------------------------------------------------

CREATE TABLE scholarships (
    scholarship_id INT AUTO_INCREMENT PRIMARY KEY,
    scholarship_name VARCHAR(150) NOT NULL,
    provider VARCHAR(150) NOT NULL,
    description TEXT,
    minimum_gpa DECIMAL(3,2),
    income_requirement DECIMAL(10,2),
    location_requirement VARCHAR(150), -- human-readable text shown in the UI
    citizenship_requirement VARCHAR(50),
    academic_requirements TEXT,
    required_documents TEXT,
    benefits TEXT,
    application_deadline DATE,
    application_start_date DATE,
    application_end_date DATE,
    application_url VARCHAR(255),
    scholarship_status ENUM('open', 'closed', 'upcoming') DEFAULT 'upcoming',
    added_by INT, -- which admin entered this record
    date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (added_by) REFERENCES administrators(admin_id) ON DELETE SET NULL
);

CREATE TABLE scholarship_courses (
    scholarship_id INT,
    course_id INT,
    PRIMARY KEY (scholarship_id, course_id),
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE,
    FOREIGN KEY (course_id) REFERENCES courses(course_id) ON DELETE CASCADE
);

CREATE TABLE scholarship_year_levels (
    scholarship_id INT,
    year_level_id INT,
    PRIMARY KEY (scholarship_id, year_level_id),
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE,
    FOREIGN KEY (year_level_id) REFERENCES year_levels(year_level_id) ON DELETE CASCADE
);

CREATE TABLE scholarship_tags (
    scholarship_id INT,
    tag_id INT,
    PRIMARY KEY (scholarship_id, tag_id),
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE,
    FOREIGN KEY (tag_id) REFERENCES tags(tag_id) ON DELETE CASCADE
);

CREATE TABLE scholarship_locations (
    scholarship_id INT,
    location_id INT,
    PRIMARY KEY (scholarship_id, location_id),
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE,
    FOREIGN KEY (location_id) REFERENCES locations(location_id) ON DELETE CASCADE
    -- A scholarship with NO rows here is treated as open to all locations (nationwide)
);

-- ------------------------------------------------------------
-- CLUSTER 4: ASSESSMENT / PROFILE PIPELINE
-- Reuses the `tags` table for student_profile_scores — this is
-- what lets the matching engine JOIN a student's scores directly
-- against a scholarship's tags instead of hardcoded logic.
-- ------------------------------------------------------------

CREATE TABLE assessments (
    assessment_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    date_taken TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE
);

CREATE TABLE assessment_answers (
    answer_id INT AUTO_INCREMENT PRIMARY KEY,
    assessment_id INT NOT NULL,
    question_key VARCHAR(100) NOT NULL, -- e.g. 'bfi10_item_1'
    answer_value VARCHAR(255) NOT NULL, -- raw Likert response, e.g. '4'
    FOREIGN KEY (assessment_id) REFERENCES assessments(assessment_id) ON DELETE CASCADE
);

CREATE TABLE student_profiles (
    profile_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    assessment_id INT NOT NULL,
    date_generated TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE,
    FOREIGN KEY (assessment_id) REFERENCES assessments(assessment_id) ON DELETE CASCADE
);

CREATE TABLE student_profile_scores (
    profile_id INT,
    tag_id INT,
    score DECIMAL(5,2) NOT NULL, -- e.g. 0.00–100.00, from the classifier's predict_proba output
    PRIMARY KEY (profile_id, tag_id),
    FOREIGN KEY (profile_id) REFERENCES student_profiles(profile_id) ON DELETE CASCADE,
    FOREIGN KEY (tag_id) REFERENCES tags(tag_id) ON DELETE CASCADE
);

-- ------------------------------------------------------------
-- CLUSTER 5: RECOMMENDATIONS
-- recommendation_reasons is what makes "explainability" a real,
-- queryable fact — the UI's checklist is a direct SELECT from here.
-- ------------------------------------------------------------

CREATE TABLE recommendations (
    recommendation_id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    scholarship_id INT NOT NULL,
    profile_id INT NOT NULL, -- which profile version produced this recommendation
    match_score DECIMAL(5,2) NOT NULL, -- e.g. 94.00 out of 100
    date_generated TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE,
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE,
    FOREIGN KEY (profile_id) REFERENCES student_profiles(profile_id) ON DELETE CASCADE
);

CREATE TABLE recommendation_reasons (
    reason_id INT AUTO_INCREMENT PRIMARY KEY,
    recommendation_id INT NOT NULL,
    criterion_name VARCHAR(100) NOT NULL, -- e.g. 'GPA Requirement', 'Course Eligibility'
    points_earned DECIMAL(5,2) NOT NULL,
    points_possible DECIMAL(5,2) NOT NULL,
    met BOOLEAN NOT NULL,
    FOREIGN KEY (recommendation_id) REFERENCES recommendations(recommendation_id) ON DELETE CASCADE
);

CREATE TABLE saved_scholarships (
    student_id INT,
    scholarship_id INT,
    date_saved TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (student_id, scholarship_id),
    FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE,
    FOREIGN KEY (scholarship_id) REFERENCES scholarships(scholarship_id) ON DELETE CASCADE
);

