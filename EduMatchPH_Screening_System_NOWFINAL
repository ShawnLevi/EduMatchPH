-- ============================================================
-- Scholarship Screening & Ranking System — Database Schema
-- FOR SOFTWARE ENGINEERING / DATA SCIENCE ONLY.
-- This is a SEPARATE system from EduMatch PH (ResCom).
-- It uses synthetic data and has no BFI-10/personality component.
-- Run this in phpMyAdmin's SQL tab, in its own database
-- (e.g. screening_db) — do NOT run this against your EduMatch
-- PH / scholarmatch_db database.
-- ============================================================

DROP TABLE IF EXISTS screening_reasons, screening_results, applicants, scholarship_programs;

-- ------------------------------------------------------------
-- Scholarship programs being screened against
-- Mirrors the SCHOLARSHIPS list hardcoded in screening_service.py
-- ------------------------------------------------------------
CREATE TABLE scholarship_programs (
    scholarship_id VARCHAR(20) PRIMARY KEY,   -- e.g. 'SCH-01'
    scholarship_name VARCHAR(150) NOT NULL,
    min_gpa DECIMAL(3,2) NOT NULL,            -- PH scale, lower = better
    income_cap DECIMAL(12,2) NOT NULL,
    eligible_field ENUM('ANY', 'STEM', 'BUSINESS') NOT NULL DEFAULT 'ANY',
    location_req VARCHAR(50) NOT NULL DEFAULT 'Nationwide',  -- 'Nationwide', 'Cebu', or a specific city
    min_entrance INT NOT NULL DEFAULT 0,
    slots INT DEFAULT NULL                    -- available slots, if limited
);

-- ------------------------------------------------------------
-- Applicant pool — one row per (synthetic) applicant
-- Matches the 8 original fields: userID, family income, GPA,
-- age, track, course, location, entrance test score
-- ------------------------------------------------------------
CREATE TABLE applicants (
    applicant_id VARCHAR(20) PRIMARY KEY,     -- e.g. 'STU-1000'
    family_income DECIMAL(12,2) NOT NULL,
    gpa DECIMAL(3,2) NOT NULL,
    age TINYINT NOT NULL,
    track ENUM('STEM', 'ABM', 'HUMSS', 'GAS', 'TVL') NOT NULL,
    course VARCHAR(100) NOT NULL,
    location VARCHAR(50) NOT NULL,
    entrance_test_score TINYINT NOT NULL,
    date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ------------------------------------------------------------
-- One row per (applicant, scholarship) screening result —
-- this is the output of Stage 1 (eligibility) + Stage 2 (ranking)
-- ------------------------------------------------------------
CREATE TABLE screening_results (
    result_id INT AUTO_INCREMENT PRIMARY KEY,
    applicant_id VARCHAR(20) NOT NULL,
    scholarship_id VARCHAR(20) NOT NULL,
    eligible BOOLEAN NOT NULL,
    priority_score DECIMAL(5,2),              -- NULL if ineligible; ML output if eligible
    rank_position INT,                        -- NULL if ineligible; rank among eligible applicants for this scholarship
    shortlist_status ENUM('SHORTLIST', 'WAITLIST', 'N/A') DEFAULT 'N/A',
    date_screened TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (applicant_id) REFERENCES applicants(applicant_id) ON DELETE CASCADE,
    FOREIGN KEY (scholarship_id) REFERENCES scholarship_programs(scholarship_id) ON DELETE CASCADE
);

-- ------------------------------------------------------------
-- Explanation breakdown per screening result — mirrors the
-- CRITERIA dict and `reasons` list in screening_service.py
-- ------------------------------------------------------------
CREATE TABLE screening_reasons (
    reason_id INT AUTO_INCREMENT PRIMARY KEY,
    result_id INT NOT NULL,
    criterion_name VARCHAR(100) NOT NULL,     -- e.g. 'GPA requirement'
    met BOOLEAN NOT NULL,
    points_earned DECIMAL(5,2) NOT NULL,
    points_possible DECIMAL(5,2) NOT NULL,
    FOREIGN KEY (result_id) REFERENCES screening_results(result_id) ON DELETE CASCADE
);

